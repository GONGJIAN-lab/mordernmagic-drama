+  const auth = `HMAC-SHA256 Credential=${BYTEPLUS_AK}/${credentialScope}, SignedHeaders=${signedHeaders}, Signature=${signature}`;
+  return { headers: { ...headers, Authorization: auth }, sortedParams };
