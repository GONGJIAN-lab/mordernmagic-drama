diff --git a/backend/prisma/schema.prisma b/backend/prisma/schema.prisma
new file mode 100644
index 0000000..f06f656
--- /dev/null
+++ b/backend/prisma/schema.prisma
@@ -0,0 +1,133 @@
+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider = "postgresql"
+  url      = env("DATABASE_URL")
+}
+
+model User {
+  id        String   @id @default(cuid())
+  email     String?  @unique
+  openId    String?  @unique
+
+  // Email OTP
+  otpCode      String?
+  otpExpiresAt DateTime?
+
+  // TikTok OAuth
+  tiktokAccessToken  String?
+  tiktokRefreshToken String?
+  tiktokTokenExpiresAt DateTime?
+
+  // Relations
+  watchHistory  WatchHistory[]
+  userUnlocks   UserUnlock[]
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+}
+
+model Drama {
+  id             String   @id @default(cuid())
+  slug           String   @unique
+  title          String
+  cover          String?
+  totalEpisodes  Int      @default(0)
+  priceCents     Int      @default(499)
+  description    String?
+  albumId        String?  // TikTok / BytePlus album_id (assigned after content review)
+
+  episodes      Episode[]
+  watchHistory  WatchHistory[]
+  userUnlocks   UserUnlock[]
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+}
+
+model Episode {
+  id                String   @id @default(cuid())
+  dramaId           String
+  episodeNumber     Int
+  s3Key             String?
+  byteplusVid       String?  // BytePlus video ID (vid)
+  byteplusEpisodeId String?  // TikTok / BytePlus episode_id (assigned after content review)
+  durationSec       Int?
+
+  drama        Drama          @relation(fields: [dramaId], references: [id])
+  watchHistory WatchHistory[]
+  userUnlocks  UserUnlock[]
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  @@unique([dramaId, episodeNumber])
+}
+
+model WatchHistory {
+  id          String @id @default(cuid())
+  userId      String
+  dramaId     String
+  episodeId   String
+  positionSec Int    @default(0)
+
+  user    User    @relation(fields: [userId], references: [id])
+  drama   Drama   @relation(fields: [dramaId], references: [id])
+  episode Episode @relation(fields: [episodeId], references: [id])
+
+  updatedAt DateTime @updatedAt
+  createdAt DateTime @default(now())
+
+  @@unique([userId, dramaId, episodeId])
+}
+
+// Webhook events (idempotent)
+model WebhookEvent {
+  id        String   @id @default(cuid())
+  eventId   String   @unique
+  eventType String
+  payload   String
+
+  createdAt DateTime @default(now())
+}
+
+// TikTok Minis Subscriptions (primary payment model)
+model MinisSubscription {
+  id             String   @id @default(cuid())
+  subscriptionId String   @unique
+  openId         String
+  skuId          String
+  orderId        String?  // webhook 中的 order_id（redeem.success 时记录）
+  status         String   @default("active")
+  startTime      DateTime?
+  expireTime     DateTime?
+  autoRenew      Boolean  @default(true)
+  nextRenewTime  DateTime?
+  cancelReason   String?
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+}
+
+// User content unlocks (legacy compat, subscription also writes here)
+model UserUnlock {
+  id         String    @id @default(cuid())
+  openId     String
+  skuId      String
+  orderId    String
+  dramaId    String?
+  episodeId  String?
+  unlockType String    // single_episode | full_drama | subscription | unknown
+  validUntil DateTime?
+
+  user    User     @relation(fields: [openId], references: [openId])
+  drama   Drama?   @relation(fields: [dramaId], references: [id])
+  episode Episode? @relation(fields: [episodeId], references: [id])
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  @@unique([openId, skuId, orderId])
+}
